# Salin file ini menjadi ".env.local", lalu isi dua nilai di bawah.
# Ambil dari Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=isi-dengan-anon-public-key

# Identitas singkat (nanti dipindah ke menu Pengaturan)
NEXT_PUBLIC_NAMA_PRAKTIK=Praktik dr.sop

# OPSIONAL (Pengaturan > Pengguna: buat akun asisten & reset kata sandi dari dalam aplikasi).
# Supabase: Project Settings > API > "service_role" key. RAHASIA: jangan dibagikan, jangan diawali NEXT_PUBLIC_.
# Tanpa ini, akun tetap bisa dibuat dan di-reset lewat dasbor Supabase (lihat README).
# SUPABASE_SERVICE_ROLE_KEY=
